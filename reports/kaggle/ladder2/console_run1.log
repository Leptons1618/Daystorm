    print("  asset_paths:", {k: len(v) for k, v in getattr(scene, "asset_paths", {}).items()})
except Exception as e:
    print("load_scene failed:", type(e).__name__, e)
    sys.exit(4)
print("nuScenes path is usable end to end")

